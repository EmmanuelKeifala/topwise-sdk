{
  "name": "@slipstream/topwise-sdk",
  "version": "0.1.0",
  "description": "Effect-TS bindings for the Topwise T1/T3/T6 Android POS SDK (React Native)",
  "keywords": [
    "topwise",
    "pos",
    "payment",
    "emv",
    "android",
    "react-native",
    "effect",
    "effect-ts",
    "aidl",
    "printer",
    "pinpad"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmmanuelKeifala/topwise-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/EmmanuelKeifala/topwise-sdk/issues"
  },
  "homepage": "https://github.com/EmmanuelKeifala/topwise-sdk#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "android",
    "react-native.js",
    "react-native.d.ts",
    "api.json",
    "CODEGEN_REPORT.md",
    "!android/build",
    "!android/.gradle"
  ],
  "scripts": {
    "extract": "node scripts/extract-api.mjs",
    "generate": "node scripts/generate.mjs",
    "codegen": "npm run extract && npm run generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "effect": ">=3.12.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "effect": "^3.12.0",
    "react-native": "^0.76.9",
    "typescript": "^5.7.0"
  }
}
